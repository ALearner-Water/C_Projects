{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "调试当前 C 文件 (GCC/GDB)",
      "type": "cppdbg",
      "request": "launch",
      "args": [],
      "stopAtEntry": false,
      "externalConsole": false,
      "cwd": "${fileDirname}",
      "program": "${fileDirname}\\${fileBasenameNoExtension}.exe",
      "preLaunchTask": "C: GCC 构建当前文件",
      "MIMode": "gdb",
      "miDebuggerPath": "D:/w64devkit/bin/gdb.exe",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}
