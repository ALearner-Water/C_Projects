{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C: GCC 构建当前文件",
            "command": "D:\\w64devkit\\bin\\gcc.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-std=c17",
                "-Wall",
                "-Wextra",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "使用 w64devkit GCC 构建当前 C 文件。"
        }
    ],
    "version": "2.0.0"
}
